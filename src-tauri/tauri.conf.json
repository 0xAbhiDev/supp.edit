{
  "$schema": "https://schema.tauri.app/config/2", "productName": "supp.edit", "version": "0.1.0", "identifier": "studio.supp.edit",
  "build": { "beforeDevCommand": "npm run dev:web", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "supp.edit", "width": 1440, "height": 940, "minWidth": 1000, "minHeight": 680, "backgroundColor": "#111315", "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'", "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
