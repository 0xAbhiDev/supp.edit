{
  "name": "supp-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first unified creative workstation",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "cargo test --workspace --exclude supp-desktop",
    "check": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write apps packages tests scripts docs *.json *.md",
    "tauri": "tauri",
    "setup:media": "node scripts/setup-media.mjs",
    "launch": "node scripts/launch.mjs",
    "eval:label": "node scripts/eval/label-server.mjs",
    "eval:run": "node scripts/eval/run.mjs",
    "eval:score": "node scripts/eval/score.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
